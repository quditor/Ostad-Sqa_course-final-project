  "item": [
    {
      "name": "get-all-users",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "console.log('this is pre-request script');"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Response body is json\", function () {\r",
              "    pm.response.to.be.json;\r",
              "});\r",
              "\r",
              "pm.test(\"Each user object has id, name, and email\", () => {\r",
              "    response.forEach((user) => {\r",
              "        pm.expect(user).to.have.property(\"id\");\r",
              "        pm.expect(user).to.have.property(\"name\");\r",
              "        pm.expect(user).to.have.property(\"email\");\r",
              "    });\r",
              "});\r",
              "\r",
              "\r",
              "\r",
              "const randomIndex = Math.floor(Math.random() * response.length);\r",
              "const randomUser = response[randomIndex];\r",
              "\r",
              "pm.environment.set(\"oldName\", randomUser.name);\r",
              "pm.environment.set(\"oldEmail\", randomUser.email);\r",
              "pm.environment.set(\"id\", randomUser.id);\r",
              "pm.environment.set(\"oldCompanyName\", randomUser.company.name);\r",
              "pm.environment.set(\"oldPhone\", randomUser.phone);\r",
              "\r",
              "        \r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update request",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const oldName = pm.environment.get(\"oldName\");\r",
              "const nName = `${oldName} Updated ${Date.now()}`; \r",
              "pm.environment.set(\"newName\", nName);\r",
              "\r",
              "\r",
              "const oldEmail = pm.environment.get(\"oldEmail\");\r",
              "const nEmail = `${oldEmail} Updated ${Date.now()}`; \r",
              "pm.environment.set(\"newEmail\", nEmail);\r",
              "\r",
              "const oldCompanyName = pm.environment.get(\"oldCompanyName\");\r",
              "const nCompanyName = `${oldCompanyName} Updated ${Date.now()}`; \r",
              "pm.environment.set(\"newCompanyName\", nCompanyName);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();\r",
              "\r",
              "pm.test(\"Status code is 200\", () => {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Returned id matches stored id\", () => {\r",
              "    pm.expect(response.id).to.eql(pm.environment.get(\"id\"));\r",
              "});\r",
              "\r",
              "pm.test(\"Phone is not empty\", () => {\r",
              "    pm.expect(pm.environment.get(\"oldPhone\")).to.not.be.empty;\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n     \r\n        \"name\": \"{{newName}}\",\r\n\r\n        \"email\": \"{{newEmail}}\",\r\n        \"company\": {\r\n           \"name\": \"{{newCompanyName}}\"\r\n    }\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://jsonplaceholder.typicode.com/users/{{id}}",
          "protocol": "https",
          "host": [
            "jsonplaceholder",
            "typicode",
            "com"
          ],
          "path": [
            "users",
            "{{id}}"
          ]
        }
      },
      "response": []
    }
  ],
