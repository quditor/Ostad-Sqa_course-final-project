  "main": "index.js",
  "scripts": {
  "test:login": "playwright test tests/InvalidLogin.spec.js",
  "test:employee": "playwright test tests/Addemployee.spec.js",
  "test:admin": "playwright test tests/Adminusermanagement.spec.js",
  "test:leave": "playwright test tests/Leavemanagement.spec.js",
  "test:ui": "playwright test --workers=1",
 "test:api": "newman run api-tests/OrangeHRM-SQA-API.postman_collection.json -e api-tests/batch-18.postman_environment.json -r cli,htmlextra --reporter-htmlextra-export api-report/api-report.html",
  "test:all": "run-s --continue-on-error test:ui test:api",
  "report:html": "playwright show-report",
  "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report"
},
